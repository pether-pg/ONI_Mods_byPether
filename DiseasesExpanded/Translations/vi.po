msgstr "CHẾ ĐỘ HOẢNG LOẠN!!!"

#. DiseasesExpanded.STRINGS.RANDOM_EVENTS.PANIC_MODE.TOAST
msgctxt "DiseasesExpanded.STRINGS.RANDOM_EVENTS.PANIC_MODE.TOAST"
