#. DiseasesExpanded.STRINGS.BUILDINGS.GERMCATCHER.DESC
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.GERMCATCHER.DESC"
msgid "Germcatchers collect germ samples for medical study and vaccine production."
msgstr "Máy Thu Thập Vi Khuẩn lấy mẫu vi khuẩn phục vụ nghiên cứu y học và sản xuất vắc-xin."

#. DiseasesExpanded.STRINGS.BUILDINGS.GERMCATCHER.EFFECT
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.GERMCATCHER.EFFECT"
msgid "Gathers ambient <link=\"DISEASE\">germs</link> and stores them in the <link=\"TESTSAMPLE\">flasks</link> for future research at an <link=\"APOTHECARY\">Apothecary</link> and vaccine production."
msgstr "Thu thập <link=\"DISEASE\">vi khuẩn</link> trong không khí và lưu trữ chúng trong các <link=\"TESTSAMPLE\">lọ mẫu</link> để nghiên cứu sau này tại <link=\"APOTHECARY\">Xưởng Bào Chế</link> và sản xuất vắc-xin."

#. DiseasesExpanded.STRINGS.BUILDINGS.GERMCATCHER.NAME
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.GERMCATCHER.NAME"
msgid "<link=\"GERMCATCHER\">Germcatcher</link>"
msgstr "<link=\"GERMCATCHER\">Máy Thu Thập Vi Khuẩn</link>"

#. DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_FORGE.DESC
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_FORGE.DESC"
msgid "Allows to manufacture and upgrade <link=\"MEDICALNANOBOTS\">Medical Nanobots</link>."
msgstr "Cho phép chế tạo và nâng cấp <link=\"MEDICALNANOBOTS\">Nanobot Y Tế</link>."

#. DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_FORGE.EFFECT
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_FORGE.EFFECT"
msgid "Duplicants with <link=\"MEDICINE3\">Advanced Medical Care</link> training can use this building to create <link=\"MEDICALNANOBOTS\">Medical Nanobots</link> or various upgrades to them."
msgstr "Đệ được đào tạo <link=\"MEDICINE3\">Chăm Sóc Y Tế Cao Cấp</link> có thể sử dụng công trình này để tạo ra <link=\"MEDICALNANOBOTS\">Nanobot Y Tế</link> hoặc các bản nâng cấp khác nhau cho chúng."

#. DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_FORGE.NAME
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_FORGE.NAME"
msgid "<link=\"NANOBOTFORGE\">Nanobot Forge</link>"
msgstr "<link=\"NANOBOTFORGE\">Trạm Chế Tạo Nanobot</link>"

#. DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_REPLICATOR.DESC
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_REPLICATOR.DESC"
msgid "Slowly replicates Nanobots and releases them into air."
msgstr "Từ từ nhân bản Nanobot và thải chúng vào không khí."

#. DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_REPLICATOR.EFFECT
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_REPLICATOR.EFFECT"
msgid "When powered, replicates <link=\"MEDICALNANOBOTS\">Medical Nanobots</link> on a slow, but steady rate and releases them. Upgrade <link=\"NANOBOTUPGRADESPAWNINCREASE\">Nanobot Perpetuum Mobile Protocol</link> for better spawning rates."
msgstr "Khi có điện, sẽ nhân bản <link=\"MEDICALNANOBOTS\">Nanobot Y Tế</link> với tốc độ chậm nhưng ổn định rồi phóng thích chúng. Nâng cấp <link=\"NANOBOTUPGRADESPAWNINCREASE\">Giao Thức Nanobot Bất Tận</link> để có tốc độ sinh sản tốt hơn."

#. DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_REPLICATOR.NAME
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.NANOBOT_REPLICATOR.NAME"
msgid "<link=\"NANOBOTREPLICATOR\">Nanobot Replicator</link>"
msgstr "<link=\"NANOBOTREPLICATOR\">Máy Nhân Bản Nanobot</link>"

#. DiseasesExpanded.STRINGS.BUILDINGS.SHIELDGENERATOR.DESC
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.SHIELDGENERATOR.DESC"
msgid "Shields the asteroid from cosmic radiation."
msgstr "Bảo vệ Tiểu Hành Tinh khỏi bức xạ vũ trụ."

#. DiseasesExpanded.STRINGS.BUILDINGS.SHIELDGENERATOR.EFFECT
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.SHIELDGENERATOR.EFFECT"
msgid "When powered, generates shield around the asteroid to protect the surface from cosmic <link=\"RADIATION\">Radiation</link>. \n\nRequires line of sight to space."
msgstr "Khi có điện, tạo ra khiên chắn xung quanh Tiểu Hành Tinh để bảo vệ bề mặt khỏi <link=\"RADIATION\">Bức Xạ</link> vũ trụ. \n\nCần có đường nhìn thẳng ra không gian."

#. DiseasesExpanded.STRINGS.BUILDINGS.SHIELDGENERATOR.NAME
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.SHIELDGENERATOR.NAME"
msgid "<link=\"SHIELDGENERATOR\">Shield Generator</link>"
msgstr "<link=\"SHIELDGENERATOR\">Máy Tạo Khiên</link>"

#. DiseasesExpanded.STRINGS.BUILDINGS.VACCINEAPOTHECARY.DESC
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.VACCINEAPOTHECARY.DESC"
msgid "Vaccines produced here can grant your duplicants immunity for various diseases."
msgstr "Vắc-xin sản xuất tại đây có thể cấp cho Đệ của bạn khả năng miễn dịch với nhiều loại bệnh khác nhau."

#. DiseasesExpanded.STRINGS.BUILDINGS.VACCINEAPOTHECARY.EFFECT
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.VACCINEAPOTHECARY.EFFECT"
msgid "Vaccine Apothecary uses <link=\"RADIATION\">Radiation</link> to weaken <link=\"DISEASE\">germs</link> stored in a <link=\"TESTSAMPLE\">flasks</link> to produce life-saving vaccines.\n\nIt must be operated by highly-trained <link=\"ROLES\">medical</link> personnel and it is suggested to use radiation protection for the time of vaccine preparation."
msgstr "Xưởng Bào Chế Vắc-xin sử dụng <link=\"RADIATION\">Bức Xạ</link> để làm suy yếu <link=\"DISEASE\">vi khuẩn</link> được lưu trữ trong <link=\"TESTSAMPLE\">lọ mẫu</link> nhằm sản xuất ra những liều vắc-xin cứu mạng.\n\nCông trình này phải được vận hành bởi nhân viên <link=\"ROLES\">y tế</link> được đào tạo bài bản, và nên sử dụng trang bị bảo vệ bức xạ trong suốt thời gian bào chế vắc-xin."

#. DiseasesExpanded.STRINGS.BUILDINGS.VACCINEAPOTHECARY.NAME
msgctxt "DiseasesExpanded.STRINGS.BUILDINGS.VACCINEAPOTHECARY.NAME"
msgid "<link=\"VACCINEAPOTHECARY\">Vaccine Apothecary</link>"
msgstr "<link=\"VACCINEAPOTHECARY\">Xưởng Bào Chế Vắc-xin</link>"

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ATTACK.DESC
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ATTACK.DESC"
msgid "Conducted in laboratory conditions, forces Unstable Virus to mutate back it's severity genome to a weaker form."
msgstr "Được thực hiện trong điều kiện phòng thí nghiệm, buộc Vi-rút Không Ổn Định đột biến ngược gen mức độ nghiêm trọng của nó về dạng yếu hơn."

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ATTACK.NAME
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ATTACK.NAME"
msgid "<link=\"MUTATINGGERMS\">Controlled Severity Mutation</link>"
msgstr "<link=\"MUTATINGGERMS\">Đột Biến Nghiêm Trọng Có Kiểm Soát</link>"

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ATTACK.RECIPEDESC
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ATTACK.RECIPEDESC"
msgid "Weakens Unstable Virus severity"
msgstr "Làm suy yếu mức độ nghiêm trọng của Vi-rút Không Ổn Định"

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ENVIRONMENTAL.DESC
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ENVIRONMENTAL.DESC"
msgid "Conducted in laboratory conditions, forces Unstable Virus to mutate back it's environmental genome to a weaker form."
msgstr "Được thực hiện trong điều kiện phòng thí nghiệm, buộc Vi-rút Không Ổn Định đột biến ngược gen môi trường của nó về dạng yếu hơn."

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ENVIRONMENTAL.NAME
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ENVIRONMENTAL.NAME"
msgid "<link=\"MUTATINGGERMS\">Controlled Environmental Mutation</link>"
msgstr "<link=\"MUTATINGGERMS\">Đột Biến Môi Trường Có Kiểm Soát</link>"

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ENVIRONMENTAL.RECIPEDESC
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.ENVIRONMENTAL.RECIPEDESC"
msgid "Weakens Unstable Virus ability to live in various environments"
msgstr "Làm suy yếu khả năng sinh tồn của Vi-rút Không Ổn Định trong nhiều môi trường khác nhau"

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.MUTATIONRATEREDUCTION.DESC
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.MUTATIONRATEREDUCTION.DESC"
msgid "Conducted in laboratory conditions, reduces ability of Unstable Virus to mutate."
msgstr "Được thực hiện trong điều kiện phòng thí nghiệm, làm giảm khả năng đột biến của Vi-rút Không Ổn Định."

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.MUTATIONRATEREDUCTION.NAME
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.MUTATIONRATEREDUCTION.NAME"
msgid "<link=\"MUTATINGGERMS\">Mutation Rate Reduction</link>"
msgstr "<link=\"MUTATINGGERMS\">Giảm Tốc Độ Đột Biến</link>"

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.MUTATIONRATEREDUCTION.RECIPEDESC
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.MUTATIONRATEREDUCTION.RECIPEDESC"
msgid "Slows down mutation rate of Unstable Virus."
msgstr "Làm chậm tốc độ đột biến của Vi-rút Không Ổn Định."

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.RESILIANCE.DESC
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.RESILIANCE.DESC"
msgid "Conducted in laboratory conditions, forces Unstable Virus to mutate back it's resilience genome to a weaker form."
msgstr "Được thực hiện trong điều kiện phòng thí nghiệm, buộc Vi-rút Không Ổn Định đột biến ngược gen sức bền của nó về dạng yếu hơn."

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.RESILIANCE.NAME
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.RESILIANCE.NAME"
msgid "<link=\"MUTATINGGERMS\">Controlled resilience Mutation</link>"
msgstr "<link=\"MUTATINGGERMS\">Đột Biến Sức Bền Có Kiểm Soát</link>"

#. DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.RESILIANCE.RECIPEDESC
msgctxt "DiseasesExpanded.STRINGS.CONTROLLEDMUTATION.RESILIANCE.RECIPEDESC"
msgid "Weakens Unstable Virus resilience"
msgstr "Làm suy yếu sức bền của Vi-rút Không Ổn Định"

#. DiseasesExpanded.STRINGS.CURES.ALIENCURE.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.ALIENCURE.DESC"
msgid "Discourages <link=\"ALIENGERMS\">Alien Goo</link> from inhabiting the body of affected duplicant."
msgstr "Ngăn cản <link=\"ALIENGERMS\">Chất Nhầy Ngoài Hành Tinh</link> cư trú trong cơ thể của Đệ bị nhiễm."

#. DiseasesExpanded.STRINGS.CURES.ALIENCURE.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.ALIENCURE.NAME"
msgid "<link=\"ALIENSICKNESSCURE\">Alien Cure</link>"
msgstr "<link=\"ALIENSICKNESSCURE\">Thuốc Giải Ngoài Hành Tinh</link>"

#. DiseasesExpanded.STRINGS.CURES.ANTIHISTAMINEBOOSTER.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.ANTIHISTAMINEBOOSTER.DESC"
msgid "Prevents allergic reactions in the future."
msgstr "Ngăn ngừa các phản ứng dị ứng trong tương lai."

#. DiseasesExpanded.STRINGS.CURES.ANTIHISTAMINEBOOSTER.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.ANTIHISTAMINEBOOSTER.NAME"
msgid "<link=\"ANTIHISTAMINEBOOSTER\">Allergy Immuno Booster</link>"
msgstr "<link=\"ANTIHISTAMINEBOOSTER\">Thuốc Tăng Cường Miễn Dịch Dị Ứng</link>"

#. DiseasesExpanded.STRINGS.CURES.DEEPBREATH.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.DEEPBREATH.DESC"
msgid "Slightly improves duplicant's breath and germ resistance."
msgstr "Cải thiện nhẹ hơi thở và khả năng kháng vi khuẩn của Đệ."

#. DiseasesExpanded.STRINGS.CURES.DEEPBREATH.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.DEEPBREATH.NAME"
msgid "<link=\"DEEPBREATHSERUM\">Deep Breath Serum</link>"
msgstr "<link=\"DEEPBREATHSERUM\">Huyết Thanh Hơi Thở Sâu</link>"

#. DiseasesExpanded.STRINGS.CURES.GASCURE.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.GASCURE.DESC"
msgid "If a berry sprouts in a duplicant's belly, their farts will smell like flowers"
msgstr "Nếu một hạt mọc mầm trong bụng Đệ, những cái rắm của họ sẽ có mùi như hoa"

#. DiseasesExpanded.STRINGS.CURES.GASCURE.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.GASCURE.NAME"
msgid "<link=\"GASCURE\">Sprouting Tablet</link>"
msgstr "<link=\"GASCURE\">Viên Nén Nảy Mầm</link>"

#. DiseasesExpanded.STRINGS.CURES.HAPPYPILL.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.HAPPYPILL.DESC"
msgid "Improves overall <link=\"MORALE\">happiness</link> of affected duplicant but reduces their motivation to perform even the most basic tasks."
msgstr "Cải thiện <link=\"MORALE\">sự hạnh phúc</link> tổng thể của Đệ bị ảnh hưởng nhưng làm giảm động lực thực hiện ngay cả những công việc cơ bản nhất."

#. DiseasesExpanded.STRINGS.CURES.HAPPYPILL.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.HAPPYPILL.NAME"
msgid "<link=\"HAPPYPILL\">Happy Pill</link>"
msgstr "<link=\"HAPPYPILL\">Viên Thuốc Vui Vẻ</link>"

#. DiseasesExpanded.STRINGS.CURES.MUDMASK.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.MUDMASK.DESC"
msgid "When covered in mud, duplicants are not so tasty for <link=\"BOGINSECTS\">Bog Bugs</link>."
msgstr "Khi phủ đầy bùn, Đệ sẽ không còn hấp dẫn với <link=\"BOGINSECTS\">Rệp Đầm Lầy</link> nữa."

#. DiseasesExpanded.STRINGS.CURES.MUDMASK.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.MUDMASK.NAME"
msgid "<link=\"MUDMASK\">Muddy Salve</link>"
msgstr "<link=\"MUDMASK\">Thuốc Mỡ Bùn</link>"

#. DiseasesExpanded.STRINGS.CURES.MUTATINGANTIVIRAL.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.MUTATINGANTIVIRAL.DESC"
msgid "Cures from, and grants immunity to <link=\"MUTATINGGERMS\">Mutating Disease</link> for a short time."
msgstr "Chữa khỏi và cấp miễn dịch tạm thời với <link=\"MUTATINGGERMS\">Bệnh Đột Biến</link> trong một thời gian ngắn."

#. DiseasesExpanded.STRINGS.CURES.MUTATINGANTIVIRAL.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.MUTATINGANTIVIRAL.NAME"
msgid "<link=\"MUTATINGANTIVIRAL\">Unstable Antiviral</link>"
msgstr "<link=\"MUTATINGANTIVIRAL\">Thuốc Kháng Vi-rút Không Ổn Định</link>"

#. DiseasesExpanded.STRINGS.CURES.RADSHOT.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.RADSHOT.DESC"
msgid "Uranium contains about 18 million kCal per gram - enough to quickly satisfy even the most <link=\"HUNGERGERMS\">overwhelming hunger</link>."
msgstr "Uranium chứa khoảng 18 triệu kCal mỗi gram - đủ để nhanh chóng thỏa mãn ngay cả <link=\"HUNGERGERMS\">cơn đói dữ dội nhất</link>."

#. DiseasesExpanded.STRINGS.CURES.RADSHOT.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.RADSHOT.NAME"
msgid "<link=\"RADSHOT\">Sweet Rad Shot</link>"
msgstr "<link=\"RADSHOT\">Mũi Tiêm Phóng Xạ Ngọt Ngào</link>"

#. DiseasesExpanded.STRINGS.CURES.RUST_2_CURE.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.RUST_2_CURE.DESC"
msgid "Cures duplicant from <link=\"RUSTSICKNESS2\">Rust Dust Crust (stage 2)</link>."
msgstr "Chữa khỏi cho Đệ khỏi <link=\"RUSTSICKNESS2\">Lớp Gỉ Bụi (giai đoạn 2)</link>."

#. DiseasesExpanded.STRINGS.CURES.RUST_2_CURE.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.RUST_2_CURE.NAME"
msgid "<link=\"RUSTSICKNESS2CURE\">Medical Oil</link>"
msgstr "<link=\"RUSTSICKNESS2CURE\">Dầu Y Tế</link>"

#. DiseasesExpanded.STRINGS.CURES.RUST_3_CURE.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.RUST_3_CURE.DESC"
msgid "Replaces parts damaged by <link=\"RUSTSICKNESS3\">Rust Dust Crust (stage 3)</link>."
msgstr "Thay thế các bộ phận bị hư hại bởi <link=\"RUSTSICKNESS3\">Lớp Gỉ Bụi (giai đoạn 3)</link>."

#. DiseasesExpanded.STRINGS.CURES.RUST_3_CURE.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.RUST_3_CURE.NAME"
msgid "<link=\"RUSTSICKNESS3CURE\">Spare Parts Shot</link>"
msgstr "<link=\"RUSTSICKNESS3CURE\">Mũi Tiêm Phụ Tùng Thay Thế</link>"

#. DiseasesExpanded.STRINGS.CURES.SAPSHOT.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.SAPSHOT.DESC"
msgid "Thick and full of sugar, Sweet Sap Shot condenses many calories into one syringe to quickly satisfy even the most <link=\"HUNGERGERMS\">overwhelming hunger</link>."
msgstr "Đặc sánh và đầy đường, Mũi Tiêm Nhựa Cây Ngọt cô đọng nhiều calo vào một ống tiêm để nhanh chóng thỏa mãn ngay cả <link=\"HUNGERGERMS\">cơn đói dữ dội nhất</link>."

#. DiseasesExpanded.STRINGS.CURES.SAPSHOT.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.SAPSHOT.NAME"
msgid "<link=\"SAPSHOT\">Sweet Sap Shot</link>"
msgstr "<link=\"SAPSHOT\">Mũi Tiêm Nhựa Cây Ngọt</link>"

#. DiseasesExpanded.STRINGS.CURES.SUNBURNCURE.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.SUNBURNCURE.DESC"
msgid "Cures duplicant from severe <link=\"SUNBURNSICKNESS\">Sunburn</link>."
msgstr "Chữa khỏi cho Đệ khỏi <link=\"SUNBURNSICKNESS\">Cháy Nắng</link> nghiêm trọng."

#. DiseasesExpanded.STRINGS.CURES.SUNBURNCURE.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.SUNBURNCURE.NAME"
msgid "<link=\"SUNBURNCURE\">Sun Lotion</link>"
msgstr "<link=\"SUNBURNCURE\">Kem Chống Nắng</link>"

#. DiseasesExpanded.STRINGS.CURES.SUPERSERUM.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.SUPERSERUM.DESC"
msgid "Enhances duplicant's attributes and makes them immune to the most dangerous pathogens."
msgstr "Tăng cường các thuộc tính của Đệ và giúp họ miễn dịch với những mầm bệnh nguy hiểm nhất."

#. DiseasesExpanded.STRINGS.CURES.SUPERSERUM.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.SUPERSERUM.NAME"
msgid "<link=\"SUPERSERUM\">Super Serum</link>"
msgstr "<link=\"SUPERSERUM\">Huyết Thanh Siêu Việt</link>"

#. DiseasesExpanded.STRINGS.CURES.TUMMYSERUM.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.TUMMYSERUM.DESC"
msgid "Calms even the most angry tummy and makes it immune to subsequent infections."
msgstr "Xoa dịu ngay cả chiếc bụng nổi giận nhất và giúp nó miễn dịch với các đợt nhiễm trùng tiếp theo."

#. DiseasesExpanded.STRINGS.CURES.TUMMYSERUM.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.TUMMYSERUM.NAME"
msgid "<link=\"TUMMYSERUM\">Tummy Serum</link>"
msgstr "<link=\"TUMMYSERUM\">Huyết Thanh Bao Tử</link>"

#. DiseasesExpanded.STRINGS.CURES.VACCINE.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.VACCINE.DESC"
msgid "Grants immunity to {0} disease."
msgstr "Cấp miễn dịch với bệnh {0}."

#. DiseasesExpanded.STRINGS.CURES.VACCINE.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.VACCINE.NAME"
msgid "{0} Vaccine"
msgstr "Vắc-xin {0}"

#. DiseasesExpanded.STRINGS.CURES.YUMMYSERUM.DESC
msgctxt "DiseasesExpanded.STRINGS.CURES.YUMMYSERUM.DESC"
msgid "Stimulates duplicant's digestive system and makes them immune to the most ravenous pathogens."
msgstr "Kích thích hệ tiêu hóa của Đệ và giúp họ miễn dịch với những mầm bệnh háu đói nhất."

#. DiseasesExpanded.STRINGS.CURES.YUMMYSERUM.NAME
msgctxt "DiseasesExpanded.STRINGS.CURES.YUMMYSERUM.NAME"
msgid "<link=\"YUMMYSERUM\">Yummy Serum</link>"
msgstr "<link=\"YUMMYSERUM\">Huyết Thanh Ngon Miệng</link>"

#. DiseasesExpanded.STRINGS.DISEASES.ALIENSICKNESS.DESCRIPTION
msgctxt "DiseasesExpanded.STRINGS.DISEASES.ALIENSICKNESS.DESCRIPTION"
msgid "Alien microbes increase duplicant's skills. However, this feels unnatural and makes infected duplicant stressed out. The goo is perfectly adapted for space travels and it will rapidly grow wherever radiation is present."
msgstr "Vi sinh vật ngoài hành tinh làm tăng kỹ năng của Đệ. Tuy nhiên, cảm giác này không tự nhiên và khiến Đệ bị nhiễm căng thẳng. Chất nhầy này thích nghi hoàn hảo với du hành vũ trụ và sẽ phát triển nhanh chóng ở bất cứ nơi nào có bức xạ."

