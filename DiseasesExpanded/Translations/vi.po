msgstr "AAAAAAAAAAAAAAAAAAAAAA!!!!!"

#. DiseasesExpanded.STRINGS.RANDOM_EVENTS.PLAGUE_OF_HUNGER.NAME
msgctxt "DiseasesExpanded.STRINGS.RANDOM_EVENTS.PLAGUE_OF_HUNGER.NAME"
msgid "Plague of Hunger"
msgstr "Đại Dịch Đói Khát"

#. DiseasesExpanded.STRINGS.RANDOM_EVENTS.PLAGUE_OF_HUNGER.TOAST
msgctxt "DiseasesExpanded.STRINGS.RANDOM_EVENTS.PLAGUE_OF_HUNGER.TOAST"
