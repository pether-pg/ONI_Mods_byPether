msgstr "Ngày tận thế đã gần kề!"

#. DiseasesExpanded.STRINGS.RANDOM_EVENTS.PANIC_MODE.NAME
msgctxt "DiseasesExpanded.STRINGS.RANDOM_EVENTS.PANIC_MODE.NAME"
