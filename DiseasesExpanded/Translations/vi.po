msgstr "<link=\"MEDICALNANOBOTS\">Giao Thức Tăng Cường Miễn Dịch Nanobot</link>"

#. DiseasesExpanded.STRINGS.NANOBOTDEVELOPMENT.SPAWNING.DESC
msgctxt "DiseasesExpanded.STRINGS.NANOBOTDEVELOPMENT.SPAWNING.DESC"
