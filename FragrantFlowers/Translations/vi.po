#. FragrantFlowers.STRINGS.BUILDINGS.VAPORIZER.DESC
msgctxt "FragrantFlowers.STRINGS.BUILDINGS.VAPORIZER.DESC"
msgid "While working, releases various scents into the air."
msgstr "Khi hoạt động, phát tán nhiều loại hương thơm khác nhau vào không khí."

#. FragrantFlowers.STRINGS.BUILDINGS.VAPORIZER.EFFECT
msgctxt "FragrantFlowers.STRINGS.BUILDINGS.VAPORIZER.EFFECT"
msgid "While working, releases various scents into the air."
msgstr "Khi hoạt động, phát tán nhiều loại hương thơm khác nhau vào không khí."

#. FragrantFlowers.STRINGS.BUILDINGS.VAPORIZER.NAME
msgctxt "FragrantFlowers.STRINGS.BUILDINGS.VAPORIZER.NAME"
msgid "Vaporizer"
msgstr "Máy Xông Hương"

#. FragrantFlowers.STRINGS.CROPS.COTTONBOLL.DESC
msgctxt "FragrantFlowers.STRINGS.CROPS.COTTONBOLL.DESC"
msgid "A soft, fluffy staple fiber that grows in a boll encased in ice crystals. The fiber of the boll is almost pure cellulose, but also contains high concentration of aromatic oils that gives it a smooth and pleasing scent."
msgstr "Một loại sợi mềm, bông xốp mọc trong quả nang được bao bọc bởi các tinh thể băng. Sợi trong quả nang gần như là cellulose nguyên chất, nhưng cũng chứa nồng độ cao tinh dầu thơm tạo cho nó một hương thơm êm dịu và dễ chịu."

#. FragrantFlowers.STRINGS.CROPS.COTTONBOLL.NAME
msgctxt "FragrantFlowers.STRINGS.CROPS.COTTONBOLL.NAME"
msgid "<link=\"RIMEDCOTTON\">Rimed Cotton Boll</link>"
msgstr "<link=\"RIMEDCOTTON\">Quả Bông Phủ Sương Giá</link>"

#. FragrantFlowers.STRINGS.CROPS.DUSKBERRY.DESC
msgctxt "FragrantFlowers.STRINGS.CROPS.DUSKBERRY.DESC"
msgid "A small, soft, jelly filled fruiting body of a <link=\"DUSKBERRYLAVENDER\">Duskberry Lavender</link>. They taste delightful and have a slightly sweet tart flavor that is mixed with a little bit of acidic."
msgstr "Một quả nhỏ, mềm, chứa đầy thạch của <link=\"DUSKBERRYLAVENDER\">Oải Hương Duskberry</link>. Chúng có vị rất ngon, hơi ngọt chua pha lẫn chút vị chua nhẹ."

#. FragrantFlowers.STRINGS.CROPS.DUSKBERRY.NAME
msgctxt "FragrantFlowers.STRINGS.CROPS.DUSKBERRY.NAME"
msgid "<link=\"DUSKBERRY\">Duskberry</link>"
msgstr "<link=\"DUSKBERRY\">Duskberry</link>"

#. FragrantFlowers.STRINGS.CROPS.DUSKBLOOM.DESC
msgctxt "FragrantFlowers.STRINGS.CROPS.DUSKBLOOM.DESC"
msgid "The gentle blossom of a <link=\"DUSKBLOOMLAVENDER\">Duskbloom Lavender</link>. It has a delicate, sweet smell that is floral, herbal, and evergreen woodsy at the same time."
msgstr "Bông hoa dịu dàng của <link=\"DUSKBLOOMLAVENDER\">Oải Hương Duskbloom</link>. Nó có mùi thơm tinh tế, ngọt ngào, vừa có hương hoa, hương thảo mộc, vừa mang mùi gỗ thường xanh."

#. FragrantFlowers.STRINGS.CROPS.DUSKBLOOM.NAME
msgctxt "FragrantFlowers.STRINGS.CROPS.DUSKBLOOM.NAME"
msgid "<link=\"DUSKBLOOM\">Duskbloom</link>"
msgstr "<link=\"DUSKBLOOM\">Duskbloom</link>"

#. FragrantFlowers.STRINGS.CROPS.SPINOSAHIPS.DESC
msgctxt "FragrantFlowers.STRINGS.CROPS.SPINOSAHIPS.DESC"
msgid "A small, berry-sized, reddish fruiting body of a <link=\"SUPERSPINOSAPLANT\">Fruiting Spinosa</link>. These have a floral, slightly sweet flavor with a touch of tartness, rich in Vitamin C."
msgstr "Một quả nhỏ cỡ quả mọng, màu đỏ của <link=\"SUPERSPINOSAPLANT\">Spinosa Kết Trái</link>. Chúng có hương hoa, vị hơi ngọt pha chút chua nhẹ, giàu Vitamin C."

#. FragrantFlowers.STRINGS.CROPS.SPINOSAHIPS.NAME
msgctxt "FragrantFlowers.STRINGS.CROPS.SPINOSAHIPS.NAME"
msgid "<link=\"SPINOSAHIPS\">Spinosa Hips</link>"
msgstr "<link=\"SPINOSAHIPS\">Quả Tầm Xuân Spinosa</link>"

#. FragrantFlowers.STRINGS.CROPS.SPINOSAROSE.DESC
msgctxt "FragrantFlowers.STRINGS.CROPS.SPINOSAROSE.DESC"
msgid "The beautiful blossom of a <link=\"SPINOSAPLANT\">Spinosa</link>. It has a simultaneously sweet and spicy smell, giving ode to meadows, honey, and fruit notes."
msgstr "Bông hoa xinh đẹp của <link=\"SPINOSAPLANT\">Spinosa</link>. Nó có mùi hương vừa ngọt vừa cay nồng, gợi nhớ đến đồng cỏ, mật ong và hương trái cây."

#. FragrantFlowers.STRINGS.CROPS.SPINOSAROSE.NAME
msgctxt "FragrantFlowers.STRINGS.CROPS.SPINOSAROSE.NAME"
msgid "<link=\"SPINOSAROSE\">Spinosa Rose</link>"
msgstr "<link=\"SPINOSAROSE\">Hồng Spinosa</link>"

#. FragrantFlowers.STRINGS.DESCRIPTORS.SPAWNGERMS.DESC
msgctxt "FragrantFlowers.STRINGS.DESCRIPTORS.SPAWNGERMS.DESC"
msgid "While working, releases {GERMS} into the air."
msgstr "Khi hoạt động, phát tán {GERMS} vào không khí."

#. FragrantFlowers.STRINGS.DESCRIPTORS.SPAWNGERMS.NAME
msgctxt "FragrantFlowers.STRINGS.DESCRIPTORS.SPAWNGERMS.NAME"
msgid "{GERMS}"
msgstr "{GERMS}"

#. FragrantFlowers.STRINGS.EFFECTS.SMELLEDLAVENDER.DESC
msgctxt "FragrantFlowers.STRINGS.EFFECTS.SMELLEDLAVENDER.DESC"
msgid "This one just smelled some Lavender, feeling much closer to the nature as a result."
msgstr "Đệ này vừa ngửi thấy mùi Oải Hương, nhờ đó cảm thấy gần gũi hơn với thiên nhiên."

#. FragrantFlowers.STRINGS.EFFECTS.SMELLEDLAVENDER.NAME
msgctxt "FragrantFlowers.STRINGS.EFFECTS.SMELLEDLAVENDER.NAME"
msgid "Smelled Lavender"
msgstr "Ngửi Thấy Oải Hương"

#. FragrantFlowers.STRINGS.EFFECTS.SMELLEDMALLOW.DESC
msgctxt "FragrantFlowers.STRINGS.EFFECTS.SMELLEDMALLOW.DESC"
msgid "This duplicant just smelled some Mallow and is invigorated to work faster."
msgstr "Đệ này vừa ngửi thấy mùi Cẩm Quỳ, cảm thấy tràn đầy sinh lực để làm việc nhanh hơn."

#. FragrantFlowers.STRINGS.EFFECTS.SMELLEDMALLOW.NAME
msgctxt "FragrantFlowers.STRINGS.EFFECTS.SMELLEDMALLOW.NAME"
msgid "Smelled Mallow"
msgstr "Ngửi Thấy Cẩm Quỳ"

#. FragrantFlowers.STRINGS.EFFECTS.SMELLEDROSE.DESC
msgctxt "FragrantFlowers.STRINGS.EFFECTS.SMELLEDROSE.DESC"
msgid "This duplicant just smelled some Roses and is now inspired to create great things."
msgstr "Đệ này vừa ngửi thấy mùi Hoa Hồng, giờ đây cảm thấy được truyền cảm hứng để tạo ra những điều tuyệt vời."

#. FragrantFlowers.STRINGS.EFFECTS.SMELLEDROSE.NAME
msgctxt "FragrantFlowers.STRINGS.EFFECTS.SMELLEDROSE.NAME"
msgid "Smelled Roses"
msgstr "Ngửi Thấy Hoa Hồng"

#. FragrantFlowers.STRINGS.FOOD.DUSKBUN.DESC
msgctxt "FragrantFlowers.STRINGS.FOOD.DUSKBUN.DESC"
msgid "A <link=\"COLDWHEATBREAD\">Frost Bun</link> filled with <link=\"DUSKJAM\">Duskjam</link>."
msgstr "Một chiếc <link=\"COLDWHEATBREAD\">Bánh Mì Sương Giá</link> nhân <link=\"DUSKJAM\">Mứt Duskjam</link>."

#. FragrantFlowers.STRINGS.FOOD.DUSKBUN.NAME
msgctxt "FragrantFlowers.STRINGS.FOOD.DUSKBUN.NAME"
msgid "<link=\"DUSKBUN\">Duskbun</link>"
msgstr "<link=\"DUSKBUN\">Duskbun</link>"

#. FragrantFlowers.STRINGS.FOOD.DUSKJAM.DESC
msgctxt "FragrantFlowers.STRINGS.FOOD.DUSKJAM.DESC"
msgid "A long lasting <link=\"DUSKBERRY\">Duskberry</link> jam preserved in <link=\"SUCROSE\">Sucrose</link>."
msgstr "Mứt <link=\"DUSKBERRY\">Duskberry</link> để được lâu, bảo quản trong <link=\"SUCROSE\">Đường Sucrose</link>."

#. FragrantFlowers.STRINGS.FOOD.DUSKJAM.NAME
msgctxt "FragrantFlowers.STRINGS.FOOD.DUSKJAM.NAME"
msgid "<link=\"DUSKJAM\">Duskjam</link>"
msgstr "<link=\"DUSKJAM\">Mứt Duskjam</link>"

#. FragrantFlowers.STRINGS.FOOD.SPINOSACAKE.DESC
msgctxt "FragrantFlowers.STRINGS.FOOD.SPINOSACAKE.DESC"
msgid "A delicious cake made from <link=\"RAWEGG\">Raw Egg</link> and <link=\"COLDWHEATSEED\">Sleet Wheat Grains</link> with <link=\"SPINOSAHIPS\">Spinosa Hips</link> on top."
msgstr "Một chiếc bánh ngon làm từ <link=\"RAWEGG\">Trứng Sống</link> và <link=\"COLDWHEATSEED\">Hạt Lúa Mì Sương Tuyết</link>, phủ <link=\"SPINOSAHIPS\">Quả Tầm Xuân Spinosa</link> lên trên."

#. FragrantFlowers.STRINGS.FOOD.SPINOSACAKE.NAME
msgctxt "FragrantFlowers.STRINGS.FOOD.SPINOSACAKE.NAME"
msgid "<link=\"SPINOSACAKE\">Spinosa Cake</link>"
msgstr "<link=\"SPINOSACAKE\">Bánh Spinosa</link>"

#. FragrantFlowers.STRINGS.FOOD.SPINOSASYRUP.DESC
msgctxt "FragrantFlowers.STRINGS.FOOD.SPINOSASYRUP.DESC"
msgid "A long lasting <link=\"SPINOSAHIPS\">Spinosa Hips</link> syrup preserved in <link=\"SUCROSE\">Sucrose</link>."
msgstr "Xi-rô <link=\"SPINOSAHIPS\">Quả Tầm Xuân Spinosa</link> để được lâu, bảo quản trong <link=\"SUCROSE\">Đường Sucrose</link>."

#. FragrantFlowers.STRINGS.FOOD.SPINOSASYRUP.NAME
msgctxt "FragrantFlowers.STRINGS.FOOD.SPINOSASYRUP.NAME"
msgid "<link=\"SPINOSASYRUP\">Spinosa Syrup</link>"
msgstr "<link=\"SPINOSASYRUP\">Xi-rô Spinosa</link>"

#. FragrantFlowers.STRINGS.GERMS.LAVENDERSCENT.DESCRIPTION
msgctxt "FragrantFlowers.STRINGS.GERMS.LAVENDERSCENT.DESCRIPTION"
msgid "Pretty nice smell of Lavenders.\n\nLavender Scent allergens trigger excessive sneezing fits in Duplicants who possess the Allergies trait."
msgstr "Mùi thơm khá dễ chịu của Oải Hương.\n\nChất gây dị ứng trong Hương Oải Hương khiến những Đệ có đặc điểm Dị Ứng bị hắt hơi liên tục."

#. FragrantFlowers.STRINGS.GERMS.LAVENDERSCENT.LEGEND_HOVERTEXT
msgctxt "FragrantFlowers.STRINGS.GERMS.LAVENDERSCENT.LEGEND_HOVERTEXT"
msgid "Lavender Scent present.\n"
msgstr "Có Hương Oải Hương.\n"

#. FragrantFlowers.STRINGS.GERMS.LAVENDERSCENT.NAME
msgctxt "FragrantFlowers.STRINGS.GERMS.LAVENDERSCENT.NAME"
msgid "<link=\"LAVENDERSCENT\">Lavender Scent</link>"
msgstr "<link=\"LAVENDERSCENT\">Hương Oải Hương</link>"

#. FragrantFlowers.STRINGS.GERMS.MALLOWSCENT.DESCRIPTION
msgctxt "FragrantFlowers.STRINGS.GERMS.MALLOWSCENT.DESCRIPTION"
msgid "Pretty nice smell of Mallows.\n\nMallows Scent allergens trigger excessive sneezing fits in Duplicants who possess the Allergies trait."
msgstr "Mùi thơm khá dễ chịu của Cẩm Quỳ.\n\nChất gây dị ứng trong Hương Cẩm Quỳ khiến những Đệ có đặc điểm Dị Ứng bị hắt hơi liên tục."

#. FragrantFlowers.STRINGS.GERMS.MALLOWSCENT.LEGEND_HOVERTEXT
msgctxt "FragrantFlowers.STRINGS.GERMS.MALLOWSCENT.LEGEND_HOVERTEXT"
msgid "Mallow Scent present.\n"
msgstr "Có Hương Cẩm Quỳ.\n"

#. FragrantFlowers.STRINGS.GERMS.MALLOWSCENT.NAME
msgctxt "FragrantFlowers.STRINGS.GERMS.MALLOWSCENT.NAME"
msgid "<link=\"MALLOWSCENT\">Mallow Scent</link>"
msgstr "<link=\"MALLOWSCENT\">Hương Cẩm Quỳ</link>"

#. FragrantFlowers.STRINGS.GERMS.ROSESCENT.DESCRIPTION
msgctxt "FragrantFlowers.STRINGS.GERMS.ROSESCENT.DESCRIPTION"
msgid "Pretty nice smell of Roses.\n\nRose Scent allergens trigger excessive sneezing fits in Duplicants who possess the Allergies trait."
msgstr "Mùi thơm khá dễ chịu của Hoa Hồng.\n\nChất gây dị ứng trong Hương Hoa Hồng khiến những Đệ có đặc điểm Dị Ứng bị hắt hơi liên tục."

#. FragrantFlowers.STRINGS.GERMS.ROSESCENT.LEGEND_HOVERTEXT
msgctxt "FragrantFlowers.STRINGS.GERMS.ROSESCENT.LEGEND_HOVERTEXT"
msgid "Rose Scent present.\n"
msgstr "Có Hương Hoa Hồng.\n"

#. FragrantFlowers.STRINGS.GERMS.ROSESCENT.NAME
msgctxt "FragrantFlowers.STRINGS.GERMS.ROSESCENT.NAME"
msgid "<link=\"ROSESCENT\">Rose Scent</link>"
msgstr "<link=\"ROSESCENT\">Hương Hoa Hồng</link>"

#. FragrantFlowers.STRINGS.PLANTS.DUSKLAVENDER.DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.DUSKLAVENDER.DESC"
msgid "A shrub-like plant blooms with a beautiful <link=\"DUSKBLOOM\">Duskbloom</link>."
msgstr "Một loại cây dạng bụi nở ra bông <link=\"DUSKBLOOM\">Duskbloom</link> xinh đẹp."

#. FragrantFlowers.STRINGS.PLANTS.DUSKLAVENDER.DOMESTICATED_DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.DUSKLAVENDER.DOMESTICATED_DESC"
msgid "In domesticated environment this crop requires the use of <link=\"PHOSPHORITE\">Phosphorite</link> as fertilization."
msgstr "Trong môi trường thuần hóa, cây trồng này cần sử dụng <link=\"PHOSPHORITE\">Phosphorite</link> làm phân bón."

#. FragrantFlowers.STRINGS.PLANTS.DUSKLAVENDER.NAME
msgctxt "FragrantFlowers.STRINGS.PLANTS.DUSKLAVENDER.NAME"
msgid "<link=\"DUSKBLOOMLAVENDER\">Duskbloom Lavender</link>"
msgstr "<link=\"DUSKBLOOMLAVENDER\">Oải Hương Duskbloom</link>"

#. FragrantFlowers.STRINGS.PLANTS.RIMEDMALLOW.DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.RIMEDMALLOW.DESC"
msgid "An evergreen plant well adapt to thrive in very cold environments. Produces a fluffy <link=\"RIMEDCOTTON\">Rimed Cotton Boll</link>."
msgstr "Một loại cây thường xanh thích nghi tốt để phát triển trong môi trường rất lạnh. Sinh ra <link=\"RIMEDCOTTON\">Quả Bông Phủ Sương Giá</link> bông xốp."

#. FragrantFlowers.STRINGS.PLANTS.RIMEDMALLOW.DOMESTICATED_DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.RIMEDMALLOW.DOMESTICATED_DESC"
msgid "In domesticated environment this crop requires the use of pure water in form of <link=\"ICE\">Ice</link> as fertilization."
msgstr "Trong môi trường thuần hóa, cây trồng này cần sử dụng nước tinh khiết dưới dạng <link=\"ICE\">Băng</link> làm phân bón."

#. FragrantFlowers.STRINGS.PLANTS.RIMEDMALLOW.NAME
msgctxt "FragrantFlowers.STRINGS.PLANTS.RIMEDMALLOW.NAME"
msgid "<link=\"RIMEDMALLOWPLANT\">Rimed Mallow</link>"
msgstr "<link=\"RIMEDMALLOWPLANT\">Cẩm Quỳ Phủ Sương Giá</link>"

#. FragrantFlowers.STRINGS.PLANTS.SPINOSA.DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.SPINOSA.DESC"
msgid "A rather thorny stem plant that blooms with a beautiful <link=\"SPINOSAROSE\">Spinosa Rose</link>."
msgstr "Một loại cây thân khá nhiều gai, nở ra bông <link=\"SPINOSAROSE\">Hồng Spinosa</link> xinh đẹp."

#. FragrantFlowers.STRINGS.PLANTS.SPINOSA.DOMESTICATED_DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.SPINOSA.DOMESTICATED_DESC"
msgid "In domesticated environment this crop requires copious amounts of <link=\"WATER\">Water</link>, and <link=\"DIRT\">Dirt</link> as fertilizer. Also requires direct exposure to sunlight."
msgstr "Trong môi trường thuần hóa, cây trồng này cần một lượng lớn <link=\"WATER\">Nước</link> và <link=\"DIRT\">Đất</link> làm phân bón. Cũng cần được tiếp xúc trực tiếp với ánh nắng mặt trời."

#. FragrantFlowers.STRINGS.PLANTS.SPINOSA.NAME
msgctxt "FragrantFlowers.STRINGS.PLANTS.SPINOSA.NAME"
msgid "<link=\"SPINOSAPLANT\">Blooming Spinosa</link>"
msgstr "<link=\"SPINOSAPLANT\">Spinosa Trổ Hoa</link>"

#. FragrantFlowers.STRINGS.PLANTS.SUPERDUSKLAVENDER.DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.SUPERDUSKLAVENDER.DESC"
msgid "A shrub-like plant sprouts with an edible <link=\"DUSKBERRY\">Duskberry</link>."
msgstr "Một loại cây dạng bụi mọc ra quả <link=\"DUSKBERRY\">Duskberry</link> ăn được."

#. FragrantFlowers.STRINGS.PLANTS.SUPERDUSKLAVENDER.DOMESTICATED_DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.SUPERDUSKLAVENDER.DOMESTICATED_DESC"
msgid "In domesticated environment this crop requires the use of <link=\"PHOSPHORITE\">Phosphorite</link> as fertilization."
msgstr "Trong môi trường thuần hóa, cây trồng này cần sử dụng <link=\"PHOSPHORITE\">Phosphorite</link> làm phân bón."

#. FragrantFlowers.STRINGS.PLANTS.SUPERDUSKLAVENDER.NAME
msgctxt "FragrantFlowers.STRINGS.PLANTS.SUPERDUSKLAVENDER.NAME"
msgid "<link=\"DUSKBERRYLAVENDER\">Duskberry Lavender</link>"
msgstr "<link=\"DUSKBERRYLAVENDER\">Oải Hương Duskberry</link>"

#. FragrantFlowers.STRINGS.PLANTS.SUPERSPINOSA.DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.SUPERSPINOSA.DESC"
msgid "A rather thorny stem plant that produces an edible <link=\"SPINOSAHIPS\">Spinosa Hips</link>."
msgstr "Một loại cây thân khá nhiều gai, sinh ra <link=\"SPINOSAHIPS\">Quả Tầm Xuân Spinosa</link> ăn được."

#. FragrantFlowers.STRINGS.PLANTS.SUPERSPINOSA.DOMESTICATED_DESC
msgctxt "FragrantFlowers.STRINGS.PLANTS.SUPERSPINOSA.DOMESTICATED_DESC"
msgid "In domesticated environment this crop requires copious amounts of <link=\"WATER\">Water</link>, and <link=\"DIRT\">Dirt</link> as fertilizer. Also requires direct exposure to sunlight."
msgstr "Trong môi trường thuần hóa, cây trồng này cần một lượng lớn <link=\"WATER\">Nước</link> và <link=\"DIRT\">Đất</link> làm phân bón. Cũng cần được tiếp xúc trực tiếp với ánh nắng mặt trời."

#. FragrantFlowers.STRINGS.PLANTS.SUPERSPINOSA.NAME
